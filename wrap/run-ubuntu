#!/bin/sh
# Run an Ubuntu-built binary from the WSLg system distro (Azure Linux, older glibc) with the Ubuntu
# distro's own loader and libraries, which are visible read-only under /mnt/wslg/distro.
# Installed under several names (symlinks); the name selects the binary.
U=/mnt/wslg/distro
HERE=$(dirname "$(readlink -f "$0")")     # <repo>/wrap, seen from the system distro
REPOG=${HERE%/wrap}; REPOG=${REPOG#$U}
. "$U$REPOG/config.env"                    # PREFIX, FREERDP_PREFIX (paths in the Ubuntu guest)
P=$U$PREFIX
LP=$U$FREERDP_PREFIX/lib:$P/lib:$P/lib/weston:$P/lib/libweston-15:$U/usr/lib/x86_64-linux-gnu:$U/lib/x86_64-linux-gnu
case "$(basename "$0")" in
	weston)               real=$P/bin/weston ;;
	weston-keyboard)      real=$P/libexec/weston-keyboard ;;
	weston-rdprail-shell) real=$P/libexec/weston-rdprail-shell ;;
	weston-desktop-shell) real=$P/libexec/weston-desktop-shell ;;
	*) echo "run-ubuntu: unknown name $0" >&2; exit 127 ;;
esac
exec "$U/lib64/ld-linux-x86-64.so.2" --library-path "$LP" "$real" "$@"
