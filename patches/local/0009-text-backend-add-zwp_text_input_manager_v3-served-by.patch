+/*
+ * zwp_text_input_manager_v3 front end.
+ *
+ * A v3 client is mapped onto the same machinery that serves text-input-v1: when it enables its text input, an
+ * internal struct text_input (with ->v3 set) is activated for the seat, which starts an input_method_context for the
+ * bound zwp_input_method_v1 client (e.g. fcitx5). Requests of the v3 client are turned into context requests, the
+ * events of the context (preedit_string, commit_string, ...) are turned into v3 events followed by "done".
+ */
+struct text_input_v3 {
+	struct wl_resource *resource;
+	struct weston_compositor *ec;
+	struct weston_seat *seat;
+
+	struct weston_surface *focus;		/* surface that got "enter" */
+	struct wl_listener focus_destroy_listener;
+	struct wl_listener keyboard_focus_listener;
+	struct wl_listener seat_destroy_listener;
+	bool listening;
+
+	bool pending_enable;
+	struct {
+		bool has_surrounding;
+		char *surrounding;
+		int32_t cursor, anchor;
+		bool has_content_type;
+		uint32_t hint, purpose;
+		bool has_rect;
+		pixman_box32_t rect;
+	} pending;
+
+	uint32_t commits;		/* number of "commit" requests, the serial of "done" */
+	bool has_preedit_cursor;
+	int32_t preedit_cursor;
+
+	struct text_input *shim;	/* what the input method machinery sees */
+};
+
+static bool
+v3_is_active(struct text_input_v3 *ti3)
+{
+	struct input_method *im = ti3->seat ? ti3->seat->input_method : NULL;
+
+	return im && ti3->shim && im->input == ti3->shim;
+}
+
+static void
+v3_disable(struct text_input_v3 *ti3)
+{
+	if (v3_is_active(ti3))
+		deactivate_input_method(ti3->seat->input_method);
+	ti3->pending_enable = false;
+}
+
+static void
+v3_clear_pending_state(struct text_input_v3 *ti3)
+{
+	free(ti3->pending.surrounding);
+	memset(&ti3->pending, 0, sizeof ti3->pending);
+}
+
+static void
+v3_done(struct text_input *input)
+{
+	zwp_text_input_v3_send_done(input->v3->resource, input->v3->commits);
+}
+
+static void
+v3_commit_string(struct text_input *input, const char *text)
+{
+	input->v3->has_preedit_cursor = false;
+	zwp_text_input_v3_send_commit_string(input->v3->resource, text);
+	v3_done(input);
+}
+
+static void
+v3_preedit_cursor(struct text_input *input, int32_t cursor)
+{
+	input->v3->preedit_cursor = cursor;
+	input->v3->has_preedit_cursor = true;
+}
+
+static void
+v3_preedit_string(struct text_input *input, const char *text)
+{
+	struct text_input_v3 *ti3 = input->v3;
+
+	if (!text || !*text) {
+		zwp_text_input_v3_send_preedit_string(ti3->resource, NULL, 0, 0);
+	} else {
+		int32_t len = strlen(text);
+		int32_t cursor = ti3->has_preedit_cursor ? ti3->preedit_cursor : len;
+
+		if (cursor > len)
+			cursor = len;
+		if (cursor < -1)
+			cursor = -1;
+		zwp_text_input_v3_send_preedit_string(ti3->resource, text, cursor, cursor);
+	}
+	v3_done(input);
+}
+
+static void
+v3_delete_surrounding_text(struct text_input *input, int32_t index, uint32_t length)
+{
+	int64_t start = index;
+	int64_t end = start + length;
+	uint32_t before = start < 0 ? -start : 0;
+	uint32_t after = end > 0 ? end : 0;
+
+	zwp_text_input_v3_send_delete_surrounding_text(input->v3->resource, before, after);
+	v3_done(input);
+}
+
+/* text-input-v3 purposes from "pin" on are one higher than the ones of v1 */
+static uint32_t
+v3_purpose_to_v1(uint32_t purpose)
+{
+	switch (purpose) {
+	case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_PIN:
+		return ZWP_TEXT_INPUT_V1_CONTENT_PURPOSE_PASSWORD;
+	case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DATE:
+		return ZWP_TEXT_INPUT_V1_CONTENT_PURPOSE_DATE;
+	case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_TIME:
+		return ZWP_TEXT_INPUT_V1_CONTENT_PURPOSE_TIME;
+	case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_DATETIME:
+		return ZWP_TEXT_INPUT_V1_CONTENT_PURPOSE_DATETIME;
+	case ZWP_TEXT_INPUT_V3_CONTENT_PURPOSE_TERMINAL:
+		return ZWP_TEXT_INPUT_V1_CONTENT_PURPOSE_TERMINAL;
+	default:
+		return purpose;	/* normal ... password have the same values */
+	}
+}
+
+static void
+ti3_destroy_request(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static void
+ti3_enable(struct wl_client *client, struct wl_resource *resource)
+{
+	struct text_input_v3 *ti3 = wl_resource_get_user_data(resource);
+
+	/* an enable while it is already the active text input starts a new session of the input method */
+	if (v3_is_active(ti3) && ti3->seat->input_method->context)
+		zwp_input_method_context_v1_send_reset(
+			ti3->seat->input_method->context->resource);
+
+	ti3->pending_enable = true;
+}
+
+static void
+ti3_disable(struct wl_client *client, struct wl_resource *resource)
+{
+	struct text_input_v3 *ti3 = wl_resource_get_user_data(resource);
+
+	ti3->pending_enable = false;
+}
+
+static void
+ti3_set_surrounding_text(struct wl_client *client, struct wl_resource *resource,
+			 const char *text, int32_t cursor, int32_t anchor)
+{
+	struct text_input_v3 *ti3 = wl_resource_get_user_data(resource);
+
+	free(ti3->pending.surrounding);
+	ti3->pending.surrounding = strdup(text);
+	ti3->pending.cursor = cursor;
+	ti3->pending.anchor = anchor;
+	ti3->pending.has_surrounding = ti3->pending.surrounding != NULL;
+}
+
+static void
+ti3_set_text_change_cause(struct wl_client *client, struct wl_resource *resource,
+			  uint32_t cause)
+{
+}
+
+static void
+ti3_set_content_type(struct wl_client *client, struct wl_resource *resource,
+		     uint32_t hint, uint32_t purpose)
+{
+	struct text_input_v3 *ti3 = wl_resource_get_user_data(resource);
+
+	ti3->pending.hint = hint;
+	ti3->pending.purpose = purpose;
+	ti3->pending.has_content_type = true;
+}
+
+static void
+ti3_set_cursor_rectangle(struct wl_client *client, struct wl_resource *resource,
+			 int32_t x, int32_t y, int32_t width, int32_t height)
+{
+	struct text_input_v3 *ti3 = wl_resource_get_user_data(resource);
+
+	ti3->pending.rect.x1 = x;
+	ti3->pending.rect.y1 = y;
+	ti3->pending.rect.x2 = x + width;
+	ti3->pending.rect.y2 = y + height;
+	ti3->pending.has_rect = true;
+}
+
+static void
+ti3_commit(struct wl_client *client, struct wl_resource *resource)
+{
+	struct text_input_v3 *ti3 = wl_resource_get_user_data(resource);
+	struct input_method *im = ti3->seat ? ti3->seat->input_method : NULL;
+	struct input_method_context *ctx;
+
+	ti3->commits++;
+
+	if (!im)
+		return;
+
+	if (!ti3->pending_enable) {
+		if (v3_is_active(ti3))
+			deactivate_input_method(im);
+		v3_clear_pending_state(ti3);
+		return;
+	}
+
+	/* text input is only possible on the surface that got "enter" */
+	if (!ti3->focus)
+		return;
+
+	if (!v3_is_active(ti3)) {
+		/* the input panel of the input method has no show request in v3, so show it with the input */
+		ti3->shim->input_panel_visible = true;
+		text_input_activate_internal(ti3->shim, ti3->seat, ti3->focus);
+	}
+
+	ctx = v3_is_active(ti3) ? im->context : NULL;
+	if (ctx) {
+		if (ti3->pending.has_surrounding)
+			zwp_input_method_context_v1_send_surrounding_text(
+				ctx->resource, ti3->pending.surrounding,
+				ti3->pending.cursor, ti3->pending.anchor);
+		if (ti3->pending.has_content_type)
+			zwp_input_method_context_v1_send_content_type(
+				ctx->resource, ti3->pending.hint,
+				v3_purpose_to_v1(ti3->pending.purpose));
+		if (ti3->pending.has_rect) {
+			ti3->shim->cursor_rectangle = ti3->pending.rect;
+			wl_signal_emit(&ti3->ec->update_input_panel_signal,
+				       &ti3->shim->cursor_rectangle);
+		}
+		zwp_input_method_context_v1_send_commit_state(ctx->resource, ti3->commits);
+	}
+
+	v3_clear_pending_state(ti3);
+}
+
+static const struct zwp_text_input_v3_interface text_input_v3_implementation = {
+	ti3_destroy_request,
+	ti3_enable,
+	ti3_disable,
+	ti3_set_surrounding_text,
+	ti3_set_text_change_cause,
+	ti3_set_content_type,
+	ti3_set_cursor_rectangle,
+	ti3_commit,
+};
+
+/* The surface that has the keyboard focus gets "enter" on the text input of its client, the previous one "leave". */
+static void
+v3_leave_focus(struct text_input_v3 *ti3)
+{
+	struct weston_surface *surface = ti3->focus;
+
+	if (!surface)
+		return;
+
+	v3_disable(ti3);
+	wl_list_remove(&ti3->focus_destroy_listener.link);
+	ti3->focus = NULL;
+	if (surface->resource)
+		zwp_text_input_v3_send_leave(ti3->resource, surface->resource);
+}
+
+static void
+v3_focus_surface_destroyed(struct wl_listener *listener, void *data)
+{
+	struct text_input_v3 *ti3 =
+		container_of(listener, struct text_input_v3, focus_destroy_listener);
+
+	v3_disable(ti3);
+	wl_list_remove(&ti3->focus_destroy_listener.link);
+	ti3->focus = NULL;
+}
+
+static void
+v3_enter_focus(struct text_input_v3 *ti3, struct weston_surface *surface)
+{
+	if (!surface || !surface->resource ||
+	    wl_resource_get_client(surface->resource) != wl_resource_get_client(ti3->resource))
+		return;
+
+	ti3->focus = surface;
+	ti3->focus_destroy_listener.notify = v3_focus_surface_destroyed;
+	wl_signal_add(&surface->destroy_signal, &ti3->focus_destroy_listener);
+	zwp_text_input_v3_send_enter(ti3->resource, surface->resource);
+}
+
+static void
+v3_handle_keyboard_focus(struct wl_listener *listener, void *data)
+{
+	struct text_input_v3 *ti3 =
+		container_of(listener, struct text_input_v3, keyboard_focus_listener);
+	struct weston_keyboard *keyboard = data;
+
+	if (ti3->focus == keyboard->focus)
+		return;
+
+	v3_leave_focus(ti3);
+	v3_enter_focus(ti3, keyboard->focus);
+}
+
+static void
+v3_seat_destroyed(struct wl_listener *listener, void *data)
+{
+	struct text_input_v3 *ti3 =
+		container_of(listener, struct text_input_v3, seat_destroy_listener);
+
+	v3_leave_focus(ti3);
+	if (ti3->listening)
+		wl_list_remove(&ti3->keyboard_focus_listener.link);
+	ti3->listening = false;
+	wl_list_remove(&ti3->seat_destroy_listener.link);
+	ti3->seat = NULL;
+}
+
+static void
+destroy_text_input_v3(struct wl_resource *resource)
+{
+	struct text_input_v3 *ti3 = wl_resource_get_user_data(resource);
+
+	if (ti3->seat) {
+		v3_disable(ti3);
+		if (ti3->focus)
+			wl_list_remove(&ti3->focus_destroy_listener.link);
+		if (ti3->listening)
+			wl_list_remove(&ti3->keyboard_focus_listener.link);
+		wl_list_remove(&ti3->seat_destroy_listener.link);
+	}
+	v3_clear_pending_state(ti3);
+	free(ti3->shim);
+	free(ti3);
+}
+
+static void
+tim3_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static void
+tim3_get_text_input(struct wl_client *client, struct wl_resource *resource,
+		    uint32_t id, struct wl_resource *seat_resource)
+{
+	struct text_input_manager *manager = wl_resource_get_user_data(resource);
+	struct weston_seat *seat = wl_resource_get_user_data(seat_resource);
+	struct weston_keyboard *keyboard = seat ? weston_seat_get_keyboard(seat) : NULL;
+	struct text_input_v3 *ti3;
+
+	ti3 = xzalloc(sizeof *ti3);
+	ti3->resource = wl_resource_create(client, &zwp_text_input_v3_interface,
+					   wl_resource_get_version(resource), id);
+	if (!ti3->resource) {
+		wl_client_post_no_memory(client);
+		free(ti3);
+		return;
+	}
+	wl_resource_set_implementation(ti3->resource, &text_input_v3_implementation,
+				       ti3, destroy_text_input_v3);
+
+	ti3->ec = manager->ec;
+	ti3->seat = seat;
+	ti3->shim = xzalloc(sizeof *ti3->shim);
+	ti3->shim->ec = manager->ec;
+	ti3->shim->manager = manager;
+	ti3->shim->v3 = ti3;
+	wl_list_init(&ti3->shim->input_methods);
+
+	if (!seat)
+		return;
+
+	ti3->seat_destroy_listener.notify = v3_seat_destroyed;
+	wl_signal_add(&seat->destroy_signal, &ti3->seat_destroy_listener);
+
+	if (keyboard) {
+		ti3->keyboard_focus_listener.notify = v3_handle_keyboard_focus;
+		wl_signal_add(&keyboard->focus_signal, &ti3->keyboard_focus_listener);
+		ti3->listening = true;
+		/* the client may already have the focus */
+		v3_enter_focus(ti3, keyboard->focus);
+	}
+}
+
+static const struct zwp_text_input_manager_v3_interface manager_v3_implementation = {
+	tim3_destroy,
+	tim3_get_text_input,
+};
+
+static void
+bind_text_input_manager_v3(struct wl_client *client, void *data,
+			   uint32_t version, uint32_t id)
+{
+	struct wl_resource *resource;
+
+	resource = wl_resource_create(client, &zwp_text_input_manager_v3_interface,
+				      version, id);
+	if (resource)
+		wl_resource_set_implementation(resource, &manager_v3_implementation,
+					       data, NULL);
+}
+
 static void
 text_input_manager_notifier_destroy(struct wl_listener *listener, void *data)
 {
@@ -460,6 +904,7 @@ text_input_manager_notifier_destroy(struct wl_listener *listener, void *data)
 
 	wl_list_remove(&text_input_manager->destroy_listener.link);
 	wl_global_destroy(text_input_manager->text_input_manager_global);
+	wl_global_destroy(text_input_manager->text_input_manager_v3_global);
 
 	if (text_input_manager->current_text_input)
 		text_input_manager->current_text_input->manager = NULL;
@@ -480,6 +925,11 @@ text_input_manager_create(struct weston_compositor *ec)
 				 &zwp_text_input_manager_v1_interface, 1,
 				 text_input_manager, bind_text_input_manager);
 
+	text_input_manager->text_input_manager_v3_global =
+		wl_global_create(ec->wl_display,
+				 &zwp_text_input_manager_v3_interface, 1,
+				 text_input_manager, bind_text_input_manager_v3);
+
 	text_input_manager->destroy_listener.notify =
 		text_input_manager_notifier_destroy;
 	wl_signal_add(&ec->destroy_signal,
@@ -502,6 +952,11 @@ input_method_context_commit_string(struct wl_client *client,
 	struct input_method_context *context =
 		wl_resource_get_user_data(resource);
 
+	if (context->input && context->input->v3) {
+		v3_commit_string(context->input, text);
+		return;
+	}
+
 	if (context->input)
