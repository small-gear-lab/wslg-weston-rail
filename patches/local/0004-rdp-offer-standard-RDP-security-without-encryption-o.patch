diff --git a/libweston/backend-rdp/rdp.c b/libweston/backend-rdp/rdp.c
index ab4bc2fc..f69d89e1 100644
--- a/libweston/backend-rdp/rdp.c
+++ b/libweston/backend-rdp/rdp.c
@@ -45,6 +45,7 @@
 #include <arpa/inet.h>
 
 #include "rdp.h"
+#include "rdp-local-cert.h"
 
 #include <winpr/version.h>
 #include <winpr/input.h>
@@ -2014,6 +2015,21 @@ rdp_peer_init(freerdp_peer *client, struct rdp_backend *b)
 	if (!is_tls_enabled(b) && !b->rdp_key) {
 		// Disable all encryption. This should be used for debug only.
 		freerdp_settings_set_uint32(settings, FreeRDP_EncryptionLevel, ENCRYPTION_LEVEL_NONE);
+
+		/* FreeRDP 3 only offers standard RDP security (the one a local client such as WSLg's msrdc
+		 * asks for over vsock) if the server certificate is RSA 2048: it switches it off otherwise and
+		 * the negotiation fails ("server supports only NLA Security"). Nothing is encrypted with this
+		 * key (ENCRYPTION_LEVEL_NONE), it is only there to satisfy that check. */
+		rdpCertificate *local_cert = freerdp_certificate_new_from_pem(rdp_local_cert_pem);
+		rdpPrivateKey *local_key = freerdp_key_new_from_pem(rdp_local_key_pem);
+		if (!local_cert || !local_key) {
+			weston_log("cannot load the built-in RSA key and certificate\n");
+			goto error_initialize;
+		}
+		if (!freerdp_settings_set_pointer_len(settings, FreeRDP_RdpServerCertificate, local_cert, 1))
+			goto error_initialize;
+		if (!freerdp_settings_set_pointer_len(settings, FreeRDP_RdpServerRsaKey, local_key, 1))
+			goto error_initialize;
 	}
 #else
 	if (b->rdp_key)
