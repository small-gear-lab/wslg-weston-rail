 	[ 'weston-direct-display', 'internal' ],
+	[ 'xdg-activation', 'staging', 'v1' ],
 	[ 'xdg-output', 'unstable', 'v1' ],
 	[ 'xdg-shell', 'unstable', 'v6' ],
 	[ 'xdg-shell', 'stable' ],
