 input_panel_destroy(struct desktop_shell *shell);
 
+/* Activates the surface (what a click on its window does). Defined in shell.c. */
+void
+shell_backend_request_window_activate(void *shell_context,
+				      struct weston_seat *seat,
+				      struct weston_surface *surface);
+
+/* xdg-activation-v1 (xdg-activation.c) */
+struct xdg_activation;
+
+struct xdg_activation *
+xdg_activation_create(struct desktop_shell *shell);
+void
