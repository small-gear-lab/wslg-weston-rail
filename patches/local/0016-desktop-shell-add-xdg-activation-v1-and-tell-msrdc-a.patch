 desktop-shell/shell.c          |   5 +
 desktop-shell/shell.h          |  15 ++
 desktop-shell/xdg-activation.c | 403 +++++++++++++++++++++++++++++++++
 protocol/meson.build           |   1 +
 5 files changed, 427 insertions(+)
 create mode 100644 desktop-shell/xdg-activation.c

