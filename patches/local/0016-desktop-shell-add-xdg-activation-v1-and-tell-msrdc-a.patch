 typedef void (*shell_for_each_layer_func_t)(struct desktop_shell *,
 						struct weston_layer *, void *);
 
diff --git a/desktop-shell/xdg-activation.c b/desktop-shell/xdg-activation.c
new file mode 100644
index 00000000..03453128
--- /dev/null
+++ b/desktop-shell/xdg-activation.c
@@ -0,0 +1,403 @@
