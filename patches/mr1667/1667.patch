+static inline void
+rdp_matrix_transform_position(struct weston_matrix *matrix, int *x, int *y)
+{
+	struct weston_vector v;
+	if (matrix->type != 0) {
+		v.f[0] = *x;
+		v.f[1] = *y;
+		v.f[2] = 0.0f;
+		v.f[3] = 1.0f;
+		weston_matrix_transform(matrix, &v);
+		*x = v.f[0] / v.f[3];
+		*y = v.f[1] / v.f[3];
+	}
+}
+
+static inline void
+rdp_matrix_transform_scale(struct weston_matrix *matrix, int *sx, int *sy)
+{
+	struct weston_vector v;
+	if (matrix->type != 0) {
+		v.f[0] = *sx;
+		v.f[1] = *sy;
+		v.f[2] = 0.0f;
+		v.f[3] = 0.0f;
+		weston_matrix_transform(matrix, &v);
+		*sx = v.f[0]; // / v.f[3];
+		*sy = v.f[1]; // / v.f[3];
+	}
+}
