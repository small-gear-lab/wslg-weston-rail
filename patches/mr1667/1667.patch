diff --git a/include/libweston/xwayland-api.h b/include/libweston/xwayland-api.h
index 947c0983ab..ff3cf6bda7 100644
--- a/include/libweston/xwayland-api.h
+++ b/include/libweston/xwayland-api.h
@@ -161,6 +161,15 @@ struct weston_xwayland_surface_api {
 	 */
