+static UINT
+rail_client_SnapArrange(RailServerContext *context, const RAIL_SNAP_ARRANGE *arg)
+{
+	RDP_DISPATCH_TO_DISPLAY_LOOP(context, snap_arrange, arg,
+					 rail_client_SnapArrange_callback);
+	return CHANNEL_RC_OK;
+}
