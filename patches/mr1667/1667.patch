+		else
+			weston_view_set_initial_position(shsurf->view, shsurf->shell);
+	}
 	shsurf->saved_position_valid = false;
+	shsurf->maximized.grab_unmaximized = false;
 
 	weston_desktop_surface_set_orientation(shsurf->desktop_surface,
 					       shsurf->orientation);
